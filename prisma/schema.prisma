generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ FILEMAKER CONNECTIONS ============

model FMConnection {
  id          String   @id @default(cuid())
  name        String
  host        String
  port        Int      @default(443)
  database    String
  username    String
  password    String
  authType    String   @default("basic") // basic, oauth, clamid
  clientId    String?
  clientSecret String?
  refreshToken String?
  accessToken  String?
  tokenExpiry  DateTime?
  sslVerify   Boolean  @default(true)
  version     String?
  status      String   @default("disconnected") // connected, disconnected, error
  lastTested  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servers FMConnectionServer[]
  schemaCache FMSchemaCache[]
}

model FMConnectionServer {
  id           String   @id @default(cuid())
  connectionId String
  serverId     String
  fileNames    String   // JSON array of file names
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  connection FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  server     McpServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ SCHEMA CACHE ============

model FMSchemaCache {
  id           String   @id @default(cuid())
  connectionId String
  databaseName String
  layouts      String   // JSON array of layout metadata
  scripts      String   // JSON array of script metadata
  tables       String   // JSON array of table metadata
  fields       String   // JSON array of field metadata
  relationships String // JSON array of relationship metadata
  cachedAt     DateTime @default(now())

  connection FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

// ============ MCP SERVERS ============

model McpServer {
  id          String   @id @default(cuid())
  name        String
  description String?
  version     String   @default("1.0.0")
  status      String   @default("draft") // draft, staging, deployed
  serverUrl   String?
  sseToken    String?
  proxyUrl    String?
  config      String   // JSON - full server configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections    FMConnectionServer[]
  branches       Branch[]
  deployments    Deployment[]
  tools          Tool[]
}

// ============ BRANCHES (Git-like) ============

model Branch {
  id          String   @id @default(cuid())
  serverId    String
  name        String
  parentId    String?
  parent      Branch?  @relation("BranchTree", fields: [parentId], references: [id])
  children    Branch[] @relation("BranchTree")
  status      String   @default("active") // active, merged, archived, deleted
  isDefault   Boolean  @default(false)
  commitMessage String?
  commitHash  String?  @unique
  snapshot    String   // JSON - full branch state snapshot
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server     McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tools      Tool[]
}

// ============ TOOLS ============

model Tool {
  id          String   @id @default(cuid())
  branchId    String
  serverId    String
  name        String
  description String
  category    String?  // e.g., "CRUD", "Find", "Script", "Custom"
  inputSchema String   // JSON schema for tool inputs
  outputSchema String? // JSON schema for tool outputs
  handlerConfig String // JSON - how the tool maps to FM Data API
  fmLayout    String?  // FileMaker layout name
  fmScript    String?  // FileMaker script name
  fmMethod    String?  // create, read, update, delete, find, script, custom
  isEnabled   Boolean  @default(true)
  version     Int      @default(1)
  isAiGenerated Boolean @default(false)
  testConfig  String?  // JSON - saved test parameters
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  executions ToolExecution[]
  versions  ToolVersion[]
}

// ============ TOOL VERSIONS ============

model ToolVersion {
  id          String   @id @default(cuid())
  toolId      String
  version     Int
  name        String
  description String
  inputSchema String
  outputSchema String?
  handlerConfig String
  snapshot    String   // JSON - full tool state
  changeLog   String?
  createdAt   DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

// ============ TOOL EXECUTIONS ============

model ToolExecution {
  id          String   @id @default(cuid())
  toolId      String
  requestId   String?
  requestBody String?  // JSON
  responseStatus Int?
  responseBody String? // JSON
  duration    Int?     // ms
  error       String?
  status      String   @default("pending") // pending, success, error, timeout
  createdAt   DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

// ============ DEPLOYMENTS ============

model Deployment {
  id          String   @id @default(cuid())
  serverId    String
  branchId    String
  branchName  String
  branchSnapshot String // JSON - branch state at deploy time
  status      String   @default("pending") // pending, deploying, deployed, failed, rolled_back
  version     String
  changelog   String?
  deployedAt  DateTime?
  rolledBackAt DateTime?
  rollbackFrom String? // ID of deployment being rolled back to
  configSnapshot String // JSON - full deployed config
  toolCount   Int      @default(0)
  createdAt   DateTime @default(now())

  server McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ AI SUGGESTIONS ============

model AiSuggestion {
  id          String   @id @default(cuid())
  serverId    String
  branchId    String?
  schemaContext String // JSON - FM schema used for suggestion
  suggestionType String // tool_suggestion, optimization, error_fix
  title       String
  description String
  proposedConfig String // JSON - proposed tool/branch config
  status      String   @default("pending") // pending, accepted, rejected, modified
  createdAt   DateTime @default(now())
}

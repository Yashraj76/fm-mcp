generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ============ FILEMAKER SERVER CONNECTIONS (Admin API) ============

model FMServerConnection {
  id                     String   @id @default(cuid())
  userId                 String   @default("")
  name                   String
  host                   String
  port                   Int      @default(443)
  adminUsername          String
  adminPasswordEncrypted String
  sslVerify              Boolean  @default(true)
  status                 String   @default("unknown") // online | error | unknown
  lastTestedAt           DateTime?
  lastError              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  connections FMConnection[]

  @@index([userId])
}

// ============ FILEMAKER CONNECTIONS (File-level) ============

model FMConnection {
  id           String   @id @default(cuid())
  userId       String   @default("")
  name         String
  host         String
  port         Int      @default(443)
  database     String
  username     String
  password     String
  authType     String   @default("basic")
  clientId     String?
  clientSecret String?
  refreshToken String?
  accessToken  String?
  tokenExpiry  DateTime?
  sslVerify    Boolean  @default(true)
  version      String?
  status       String   @default("disconnected")
  lastTested   DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional FK to FM Server (Admin API server)
  serverConnectionId String?
  serverConnection   FMServerConnection? @relation(fields: [serverConnectionId], references: [id], onDelete: SetNull)

  servers       FMConnectionServer[]
  schemaCache   FMSchemaCache[]
  browsedSchema BrowsedSchema?
  relationshipGraph RelationshipGraph?

  @@index([userId])
}

// ============ BROWSED SCHEMA (per Connection) ============

model BrowsedSchema {
  id           String       @id @default(cuid())
  connectionId String       @unique
  connection   FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  rawLayouts             String @default("[]")
  rawScripts             String @default("[]")
  rawLayoutMeta          String @default("{}")
  rawODataTables         String @default("[]")
  rawODataMeta           String @default("{}")
  suggestedRelationships String @default("[]")
  selectedLayouts        String @default("[]")
  selectedTables         String @default("[]")
  selectedScripts        String @default("[]")
  compiledSchema         String @default("{}")

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SCHEMA CACHE ============

model FMSchemaCache {
  id           String   @id @default(cuid())
  connectionId String
  databaseName String
  layouts      String
  scripts      String
  tables       String
  fields       String
  relationships String
  cachedAt     DateTime @default(now())

  connection FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

// ============ MCP SERVERS ============

model McpServer {
  id          String   @id @default(cuid())
  userId      String   @default("")
  name        String
  description String?
  version     String   @default("1.0.0")
  status      String   @default("draft")
  serverUrl   String?
  sseToken    String?
  proxyUrl    String?
  config      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections        FMConnectionServer[]
  branches           Branch[]
  deployments        Deployment[]
  tools              Tool[]
  toolGenerationJobs ToolGenerationJob[]
  apiKey             McpApiKey?
  logs               ActivityLog[]

  @@index([userId])
}

// ============ MCP API KEYS ============

model McpApiKey {
  id         String    @id @default(cuid())
  serverId   String    @unique
  server     McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  keyHash    String
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// ============ CONNECTION ↔ SERVER JOIN ============

model FMConnectionServer {
  id           String   @id @default(cuid())
  connectionId String
  serverId     String
  fileNames    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  connection FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  server     McpServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([connectionId, serverId])
  @@index([serverId])
}

// ============ BRANCHES ============

model Branch {
  id            String    @id @default(cuid())
  name          String                           // "main" | "feature/xyz" | "hotfix/abc"
  serverId      String
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  isDefault     Boolean   @default(false)        // true = this is "main"
  isProtected   Boolean   @default(false)        // true = cannot delete (main is always protected)
  description   String?
  status        String    @default("active")     // "active" | "merged" | "archived"
  mergedIntoId  String?                          // branch this was merged into
  mergedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tools         BranchTool[]
  deployments   Deployment[]
  logs          ActivityLog[]

  @@unique([serverId, name])
}

model BranchTool {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  toolId        String
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  action        String   @default("inherited")  // "inherited"|"modified"|"added"|"deleted"
  overrideData  String?  // JSON: local branch overrides to the tool (description, schema, config)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchId, toolId])
  @@index([toolId])
}

// ============ TOOLS ============

model Tool {
  id            String   @id @default(cuid())
  serverId      String
  name          String
  description   String
  category      String?
  inputSchema   String
  outputSchema  String?
  handlerConfig String
  fmLayout      String?
  fmScript      String?
  fmMethod      String?
  isEnabled     Boolean   @default(true)
  version       Int       @default(1)
  isAiGenerated Boolean   @default(false)
  testConfig    String?
  sortOrder     Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  server     McpServer     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  executions ToolExecution[]
  branchTools BranchTool[]

  @@index([serverId])
  @@index([serverId, name])
}

// ============ TOOL EXECUTIONS ============

model ToolExecution {
  id             String   @id @default(cuid())
  toolId         String
  requestId      String?
  requestBody    String?
  responseStatus Int?
  responseBody   String?
  duration       Int?
  error          String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

// ============ DEPLOYMENTS ============

model Deployment {
  id            String   @id @default(cuid())
  serverId      String
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  version       String                           // semver: "1.0.0", "1.1.0", "2.0.0"
  snapshot      String                           // JSON: complete server+tools state at this moment
  changelog     String?                          // user-written description of what changed
  status        String   @default("active")      // "active" | "superseded" | "rolled_back"
  isLive        Boolean  @default(false)         // true = currently live on main
  deployedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  logs          ActivityLog[]

  @@index([branchId])
}

// ============ ACTIVITY LOGS ============

model ActivityLog {
  id            String   @id @default(cuid())
  
  // What happened
  action        String   // see Action Types below
  entityType    String   // "server"|"branch"|"tool"|"connection"|"deployment"|"api-key"|"schema"
  entityId      String
  entityName    String   // human-readable name at time of action

  // Context
  serverId      String?
  branchId      String?
  deploymentId  String?

  // Relations (optional — don't error if entity is deleted)
  server        McpServer?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deployment    Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  // Payload
  before        String?  // JSON snapshot of state before action (for diffs)
  after         String?  // JSON snapshot of state after action
  meta          String?  // JSON: extra context (e.g. { mergedFrom: "feature/xyz", toolCount: 12 })

  // Actor identity
  actorUserId   String?   // Supabase user UUID from the authenticated session
  actorIp       String?
  actorSession  String?

  createdAt     DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([branchId])
}

// ============ AI SUGGESTIONS ============

model AiSuggestion {
  id             String   @id @default(cuid())
  serverId       String
  branchId       String?
  schemaContext  String
  suggestionType String
  title          String
  description    String
  proposedConfig String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}

// ============ APP SETTINGS (singleton row id="singleton") ============

model AppSettings {
  id                String   @id @default("singleton")
  userId            String?
  aiProvider        String   @default("anthropic")
  aiModel           String   @default("claude-sonnet-4-5")
  aiApiKeyEncrypted String   @default("")
  aiBaseUrl         String   @default("")
  aiMaxTokens       Int      @default(4096)
  aiTemperature     Float    @default(0.7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============ RELATIONSHIP GRAPH ============

model RelationshipGraph {
  id               String   @id @default(cuid())
  connectionId     String   @unique
  connection       FMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  relationships    String   // JSON array of RelationshipEdge
  generatedBy      String   @default("ai")  // "ai" | "manual"
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============ TOOL GENERATION JOB ============

model ToolGenerationJob {
  id          String   @id @default(cuid())
  userId      String?
  serverId    String
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending"|"running"|"done"|"failed"
  progress    Int      @default(0)         // 0-100
  log         String   @default("[]")      // JSON array of log entries
  generatedTools String? // JSON array of generated tool definitions
  toolsCreated Int     @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([serverId])
}

// ============ PLAYGROUND SESSION ============

model PlaygroundSession {
  id            String   @id @default(cuid())
  userId        String?
  serverId      String?
  branchId      String?  // branch context under which this session ran; null = main branch raw tools
  userMessage   String
  agentPlan     String?  // JSON: steps the agent decided to take
  stepLog       String   @default("[]") // JSON array of step results
  finalResult   String?  // JSON
  status        String   @default("running") // "running"|"done"|"error"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
